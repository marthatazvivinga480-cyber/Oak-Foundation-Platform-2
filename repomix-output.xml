h2 {
  font-size: 23px;
}
h3 {
  font-size: 16px;
  font-weight: 700;
  line-height: 1.4;
}
p {
  line-height: 1.65;
}
svg {
  flex-shrink: 0;
}
input,
select,
textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid transparent;
  border-radius: 14px;
  background: var(--field);
  padding: 13px 16px;
  color: var(--ink);
  min-height: 49px;
}
input::placeholder,
textarea::placeholder {
  color: var(--muted);
  opacity: 1;
}
textarea {
  resize: vertical;
  min-height: 130px;
}
input[type='checkbox'] {
  width: 20px;
  height: 20px;
  min-height: 20px;
  accent-color: var(--navy);
  margin: 2px 0 0;
  flex-shrink: 0;
}
select {
  appearance: auto;
}
button {
  border: 0;
}
strong {
  font-weight: 700;
}
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 232px;
  background: white;
  border-right: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  z-index: 20;
}
.desktop-brand {
  padding: 28px 26px 24px;
  border-bottom: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.logo {
  font-family: Georgia, serif;
  font-size: 38px;
  line-height: 0.85;
  color: var(--navy);
  display: inline-block;
  letter-spacing: -3px;
  font-weight: 400;
}
.logo small {
  font-size: 9px;
  letter-spacing: 0;
  display: block;
  margin-top: 6px;
}
.eyebrow {
  font-size: 11px;
  line-height: 1.4;
  font-weight: 700;
  letter-spacing: 1.2px;
  color: var(--muted);
}
.desktop-brand > .eyebrow {
  font-size: 10px;
  letter-spacing: 0.8px;
}
.sidebar nav {
  padding: 16px;
}
.sidebar nav a {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 11px 14px;
  border-radius: 14px;
  font-weight: 600;
  color: var(--muted);
  margin-bottom: 6px;
}
.sidebar nav a:hover {
  background: var(--field);
}
.sidebar nav a.active {
  background: var(--navy);
  color: white;
  box-shadow: 0 5px 12px #162d5530;
}
.sidebar-footer {
  margin-top: auto;
  padding: 21px 22px;
  display: flex;
  gap: 10px;
  align-items: center;
  border-top: 1px solid var(--line);
  font-size: 11px;
}
.sidebar-footer svg {
  color: #9bb1c8;
}
.sidebar-footer small {
  display: block;
  color: var(--muted);
  font-size: 10px;
}
.main-shell {
  margin-left: 232px;
  min-height: 100dvh;
}
main {
  max-width: 560px;
  margin: auto;
  padding: 36px 0 50px;
}
.mobile-header,
.bottom-nav {
  display: none;
}
.stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.card {
  background: #fff;
  border: 1px solid #e4e8ef;
  border-radius: 23px;
  box-shadow: var(--shadow);
  padding: 20px;
}
.hero {
  position: relative;
  overflow: hidden;
  border-radius: 23px;
  background: radial-gradient(ellipse at 87% 23%, #3d5477 0, transparent 27%), var(--navy);
  color: white;
  padding: 28px 24px;
  box-shadow: var(--shadow);
}
.hero p {
  color: #a7b5cd;
  margin-top: 7px;
}
.hero .eyebrow {
  margin-top: 0;
  font-size: 11px;
}
.hero h1 {
  font-size: 30px;
  line-height: 1.16;
}
.registration-hero {
  min-height: 152px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}
.stat {
  padding: 16px;
  display: flex;
  flex-direction: column;
  line-height: 1.4;
  gap: 3px;
}
.stat svg {
  color: #9db7d0;
  width: 16px;
  height: 16px;
}
.stat strong {
  font-family: 'Baloo 2', sans-serif;
  font-size: 26px;
  line-height: 1.1;
  font-weight: 800;
}
.stat span {
  color: var(--muted);
  font-size: 13px;
}
.registration-card h2 {
  margin-bottom: 24px;
  font-size: 22px;
}
.form-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}
.field > span {
  font-weight: 700;
  font-size: 11px;
  text-transform: uppercase;
  color: #6b7899;
  line-height: 1.4;
}
.field em {
  font-style: normal;
  color: #f53746;
}
.requirements {
  border: 1px solid #d3dbe8;
  background: var(--field);
  border-radius: 17px;
  padding: 17px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.requirements input {
  background: white;
}
.requirements .eyebrow {
  font-size: 10px;
}
.consent {
  border: 1px solid #ccd5e5;
  border-radius: 17px;
  padding: 17px;
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 13px;
  line-height: 1.7;
}
.consent a {
  text-decoration: underline;
  text-underline-offset: 3px;
  color: #203961;
}
.button {
  border: 0;
  border-radius: 15px;
  background: linear-gradient(125deg, #1e315b, #2c487d);
  color: white;
  min-height: 50px;
  padding: 13px 20px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-weight: 700;
  box-shadow: 0 6px 14px #182f5530;
  line-height: 1.4;
}
.button:hover {
  filter: brightness(1.09);
}
.button.secondary {
  background: white;
  color: var(--ink);
  border: 1px solid var(--line);
  box-shadow: var(--shadow);
}
.button.small {
  min-height: 34px;
  padding: 8px 12px;
  border-radius: 12px;
  font-size: 12px;
}
.full {
  width: 100%;
}
.text-button {
  background: none;
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 8px;
  font-size: 13px;
}
.privacy-footer {
  text-align: center;
  color: var(--muted);
  font-size: 12px;
  padding: 0 16px;
}
.utility-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px 18px;
  margin-top: 26px;
  font-size: 11px;
  color: var(--muted);
}
.utility-footer a,
.utility-footer button {
  display: flex;
  align-items: center;
  gap: 5px;
  background: none;
  color: inherit;
}
.demo-label {
  width: 100%;
  text-align: center;
}
.status {
  padding: 12px 14px;
  background: #eef3fa;
  border-radius: 12px;
  font-size: 13px;
  color: var(--navy);
}
.status.error {
  background: #fff0f0;
  color: #a51e2d;
}
.honeypot {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}
.pass-hero {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.hero-icon {
  padding: 12px;
  background: #ffffff28;
  border-radius: 16px;
  min-width: 56px;
  width: 56px;
  height: 56px;
}
.entry-pass {
  text-align: center;
  padding: 30px 22px;
}
.qr-frame {
  background: var(--field);
  padding: 16px;
  display: table;
  border-radius: 28px;
  margin: 28px auto 12px;
}
.qr-frame img {
  border-radius: 7px;
  max-width: 100%;
  height: auto;
}
.entry-pass p:not(.eyebrow) {
  font-size: 12px;
  color: var(--muted);
}
.entry-code {
  overflow-wrap: anywhere;
  letter-spacing: 1.2px;
  margin: 12px 0 3px;
  font-size: 11px !important;
}
.details {
  margin: 14px 0 0;
}
.details > div {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
}
.details > div:last-child {
  border: 0;
}
.details dt {
  color: var(--muted);
  font-weight: 600;
}
.details dd {
  text-align: right;
  margin: 0;
  font-weight: 600;
  overflow-wrap: anywhere;
  min-width: 0;
}
.row {
  display: flex;
  align-items: center;
  gap: 12px;
}
.between {
  justify-content: space-between;
}
.modal {
  position: fixed;
  inset: 0;
  margin: auto;
  width: min(520px, calc(100% - 32px));
  max-height: 90dvh;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 23px;
  padding: 24px;
  background: white;
  color: var(--ink);
  box-shadow: 0 20px 90px #0003;
}
.modal::backdrop {
  background: #10213ab0;
  backdrop-filter: blur(4px);
}
.modal > .row {
  margin-bottom: 22px;
}
.icon-button {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--field);
  color: var(--muted);
  border-radius: 50%;
}
.skip-link {
  position: fixed;
  top: -100px;
  left: 16px;
  z-index: 100;
  background: var(--navy);
  color: white;
  padding: 10px;
}
.skip-link:focus {
  top: 10px;
}
.page-heading {
  margin-bottom: 20px;
}
.page-heading p {
  color: var(--muted);
  margin-top: 3px;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 20px;
}
.muted {
  color: var(--muted);
}
.empty-state {
  text-align: center;
  padding: 40px 22px;
}
.empty-state > svg {
  color: #9ab5cd;
  background: var(--field);
  padding: 20px;
  box-sizing: content-box;
  border-radius: 24px;
  margin: 0 auto 17px;
}
.empty-state h2 {
  margin-bottom: 7px;
}
.empty-state p {
  color: var(--muted);
  margin-bottom: 24px;
}
.empty-state .button {
  margin-top: 0;
}
.prose p {
  margin: 14px 0;
}
.prose h2 {
  margin-top: 24px;
}
@media (min-width: 768px) and (max-width: 1000px) {
  .sidebar {
    width: 190px;
  }
  .main-shell {
    margin-left: 190px;
  }
  main {
    padding-left: 24px;
    padding-right: 24px;
    max-width: 608px;
  }
}
@media (max-width: 767px) {
  body {
    font-size: 14px;
  }
  .sidebar {
    display: none;
  }
  .mobile-header {
    height: 80px;
    background: var(--navy);
    color: #bbc8de;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    font-size: 11px;
    letter-spacing: 1.1px;
    font-weight: 700;
  }
  .mobile-header .logo {
    font-size: 22px;
    color: white;
    letter-spacing: -1.5px;
  }
  .mobile-header .logo small {
    font-size: 5px;
    margin-top: 5px;
  }
  .brand-divider {
    height: 23px;
    width: 1px;
    background: #ffffff33;
  }
  .main-shell {
    margin-left: 0;
  }
  main {
    padding: 24px 16px 120px;
    max-width: 560px;
  }
  .bottom-nav {
    display: flex;
    justify-content: space-around;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffffef;
    backdrop-filter: blur(10px);
    z-index: 25;
    padding: 9px 8px max(9px, env(safe-area-inset-bottom));
    border-top: 1px solid #f0f2f6;
    min-height: 67px;
  }
  .bottom-nav a {
    color: #7783a2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 10px;
    font-weight: 700;
    min-width: 56px;
    padding: 5px 9px;
    border-radius: 20px;
  }
  .bottom-nav a.active {
    background: #ebedf1;
    color: #1c345e;
  }
  .hero {
    padding: 26px 23px;
  }
  .registration-hero {
    min-height: 166px;
  }
  .hero h1 {
    font-size: 31px;
  }
  .stats-grid {
    gap: 12px;
  }
  .stat {
    padding: 16px 15px;
    min-height: 96px;
  }
  .stat strong {
    font-size: 26px;
  }
  .card {
    border-radius: 24px;
    padding: 20px;
  }
  .registration-card {
    padding: 23px 20px 20px;
  }
  .registration-card h2 {
    margin-bottom: 24px;
  }
  .field > span {
    font-size: 11px;
  }
  .form-stack {
    gap: 16px;
  }
  input,
  select {
    min-height: 52px;
    padding: 14px 16px;
    font-size: 14px;
  }
  .requirements {
    padding: 16px;
  }
  .requirements input {
    padding-left: 15px;
    padding-right: 8px;
  }
  .consent {
    font-size: 13px;
    padding: 16px;
    gap: 12px;
  }
  .button {
    min-height: 53px;
    font-size: 15px;
  }
  .registration-page .privacy-footer {
    font-size: 12px;
  }
  .page-heading h1 {
    font-size: 28px;
  }
  .pass-hero {
    padding: 24px;
  }
  .pass-hero h1 {
    font-size: 26px;
  }
  .entry-pass {
    padding: 25px 20px;
  }
  .details {
    font-size: 13px;
  }
  .utility-footer {
    margin-top: 32px;
  }
}
.segmented {
  padding: 4px;
  display: flex;
  gap: 4px;
  background: #e5e8ef;
  border-radius: 10px;
  margin-bottom: 22px;
}
.segmented button {
  flex: 1;
  background: none;
  color: var(--muted);
  padding: 9px;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 700;
}
.segmented button.selected {
  background: white;
  color: var(--ink);
  box-shadow: 0 2px 3px #142c5208;
}
.day-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 34px;
}
.day-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 18px;
  text-align: left;
  line-height: 1.4;
  color: var(--muted);
}
.day-card strong {
  font-family: 'Baloo 2', sans-serif;
  font-weight: 800;
  font-size: 25px;
  color: var(--ink);
  line-height: 1.2;
}
.day-card > span:last-child {
  font-size: 13px;
}
.day-card.selected {
  background: var(--navy);
  color: #aab8cc;
  box-shadow: 0 6px 16px #172f5530;
}
.day-card.selected strong {
  color: white;
}
.day-card.selected .eyebrow {
  color: #b4c4dc;
}
.featured {
  padding: 24px;
  border-radius: 25px;
  background:
    radial-gradient(ellipse at 90% 15%, #2f3d56, transparent 42%),
    linear-gradient(120deg, #0e1827, #1a2945);
  color: white;
  box-shadow: var(--shadow);
}
.featured .eyebrow {
  color: #a8bbca;
  gap: 10px;
  font-size: 10px;
}
.featured h2 {
  font-size: 26px;
  margin: 22px 0 17px;
}
.featured p {
  font-size: 13px;
  color: #8a9bb0;
  margin-top: 8px;
}
.mini-avatar {
  width: 23px;
  height: 23px;
  border-radius: 50%;
  background: #ffffff1a;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-weight: 700;
  font-size: 11px;
}
.legend {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: var(--muted);
  font-size: 11px;
  margin: 14px 0 25px;
}
.legend > span {
  display: flex;
  align-items: center;
  gap: 7px;
}
.dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #20365e;
}
.dot.breakout {
  background: #f4a000;
}
.dot.workshop {
  background: #9861ff;
}
.dot.social {
  background: #ff7a10;
}
.schedule-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.break-row {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--muted);
  font-size: 12px;
  min-height: 34px;
  padding: 0 4px;
}
.break-row time {
  min-width: 42px;
}
.break-row > span {
  height: 1px;
  background: #dce1eb;
  flex: 1;
}
.break-row p {
  text-align: center;
}
.session {
  padding: 19px 22px;
}
.session summary {
  list-style: none;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  cursor: pointer;
}
.session summary::-webkit-details-marker {
  display: none;
}
.session-time {
  display: flex;
  flex-direction: column;
  font-size: 13px;
  line-height: 1.5;
  min-width: 40px;
}
.session-time span {
  font-size: 11px;
  color: var(--muted);
}
.session-body {
  flex: 1;
  min-width: 0;
}
.session-title {
  display: flex;
  gap: 12px;
  justify-content: space-between;
  align-items: flex-start;
}
.session h3 {
  font-size: 15px;
}
.session-body p {
  font-size: 12px;
  color: var(--muted);
  margin-top: 7px;
}
.session-body p.row {
  gap: 4px;
  margin-top: 3px;
}
.badge {
  display: inline-block;
  white-space: nowrap;
  border-radius: 20px;
  border: 1px solid #bccae3;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 9px;
  line-height: 1.4;
  background: #eef2fa;
  color: #203a66;
}
.badge.breakout {
  background: #fff5cb;
  border-color: #ffda62;
  color: #ad5704;
}
.badge.workshop {
  background: #f5ecff;
  border-color: #dcc2ff;
  color: #7c42c9;
}
.badge.social {
  background: #fff7ed;
  border-color: #ffca9f;
  color: #e97510;
}
.badge.staff {
  background: #ecfdf6;
  border-color: #89e8c1;
  color: #039471;
}
.disclosure {
  color: var(--muted);
  margin-top: 5px;
  transition: transform 0.2s;
}
.session[open] .disclosure {
  transform: rotate(180deg);
}
.session-description {
  border-top: 1px solid var(--line);
  margin-top: 14px;
  padding-top: 12px;
  color: var(--muted);
  font-size: 13px;
}
.docs {
  gap: 28px;
  margin-top: 30px;
}
.section-title {
  margin-bottom: 16px;
}
.section-title h2,
h2.section-title {
  font-family: 'Quicksand', sans-serif;
  font-size: 18px;
  font-weight: 700;
}
.section-title svg {
  color: #475e80;
}
.note-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 15px;
  line-height: 1.4;
}
.note-header strong {
  display: block;
  font-size: 12px;
}
.note-header small {
  color: var(--muted);
  display: block;
  font-size: 10px;
}
.note-header .time-label {
  margin-left: auto;
  align-self: flex-start;
}
.time-label {
  padding: 3px 7px;
  background: var(--field);
  color: var(--muted);
  font-size: 10px;
  border-radius: 7px;
  white-space: nowrap;
}
.note p {
  font-size: 14px;
  line-height: 1.8;
}
.avatar {
  width: 49px;
  height: 49px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: var(--navy);
  color: white;
  border-radius: 16px;
  font-weight: 700;
  font-size: 14px;
}
.avatar.small {
  width: 34px;
  height: 34px;
  border-radius: 12px;
  font-size: 11px;
  background: linear-gradient(120deg, #20335c, #324d80);
}
.avatar.large {
  width: 64px;
  height: 64px;
  border-radius: 18px;
  font-size: 18px;
}
.note-header .avatar {
  width: 29px;
  height: 29px;
  border-radius: 50%;
  font-size: 10px;
}
.gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
.gallery button {
  padding: 0;
  border-radius: 17px;
  overflow: hidden;
  background: #e9edf4;
  aspect-ratio: 1.35;
}
.gallery img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.2s;
}
