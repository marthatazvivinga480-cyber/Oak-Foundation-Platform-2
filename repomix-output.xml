                {p.website}
                <ExternalLink size={12} />
              </a>
            </div>
          </article>
        ))}
        {!filtered.length && (
          <Card className="empty-state">
            <h2>No partners found</h2>
            <p>Try another organisation, focus area or region.</p>
            <button
              className="button small"
              onClick={() => {
                setQuery('');
                setRegion('All Regions');
              }}
            >
              Clear filters
            </button>
          </Card>
        )}
      </div>
    </>
  );
}
