# Copy this file to .env.local next to package.json.
# Leave blank for local demo mode. Never use demo mode for real attendee data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Partner confirmation email (server-only). Use a verified sender in Resend.
RESEND_API_KEY=
EMAIL_FROM=
